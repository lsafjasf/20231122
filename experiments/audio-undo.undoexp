      "steps": [
        {
          "request_id": "canonical-trim",
          "base_revision": 0,
          "command": {
            "kind": "trim",
            "start_ms": 200,
            "end_ms": 1800
          }
        },
        {
          "request_id": "canonical-gain",
          "base_revision": 1,
          "command": {
            "kind": "gain",
            "gain_milli": 700
          }
        }
      ]
    },
    {
      "id": "reordered-gain-then-trim",
      "description": "Same two edits submitted in reverse order.",
      "expect": {
        "rejected_step_indices": [],
        "final_control": "v2"
      },
      "steps": [
        {
          "request_id": "reordered-gain",
          "base_revision": 0,
          "command": {
            "kind": "gain",
            "gain_milli": 700
          }
        },
        {
          "request_id": "reordered-trim",
          "base_revision": 1,
          "command": {
            "kind": "trim",
            "start_ms": 200,
            "end_ms": 1800
          }
        }
      ]
    },
    {
      "id": "duplicate-submissions",
      "description": "Replay both request IDs without changing state or history depth.",
      "expect": {
        "rejected_step_indices": [],
        "final_control": "v2"
      },
      "steps": [
        {
          "request_id": "duplicate-trim",
          "base_revision": 0,
          "command": {
            "kind": "trim",
            "start_ms": 200,
            "end_ms": 1800
          }
        },
        {
          "request_id": "duplicate-gain",
          "base_revision": 1,
          "command": {
            "kind": "gain",
            "gain_milli": 700
          }
        },
        {
          "request_id": "duplicate-trim",
          "base_revision": 2,
          "command": {
            "kind": "trim",
            "start_ms": 200,
            "end_ms": 1800
          }
        },
        {
          "request_id": "duplicate-gain",
          "base_revision": 2,
          "command": {
            "kind": "gain",
            "gain_milli": 700
          }
        }
      ]
    },
    {
      "id": "undo-redo-roundtrip",
      "description": "Undo the gain, then redo it; both snapshots remain reachable.",
      "expect": {
        "rejected_step_indices": [],
        "final_control": "v2"
      },
      "steps": [
        {
          "request_id": "roundtrip-trim",
          "base_revision": 0,
          "command": {
            "kind": "trim",
            "start_ms": 200,
            "end_ms": 1800
          }
        },
        {
          "request_id": "roundtrip-gain",
          "base_revision": 1,
          "command": {
