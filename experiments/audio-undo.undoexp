            "kind": "gain",
            "gain_milli": 700
          }
        },
        {
          "request_id": "recovery-gain",
          "base_revision": 1,
          "command": {
            "kind": "gain",
            "gain_milli": 700
          }
        }
      ]
    },
    {
      "id": "after-exception-object",
